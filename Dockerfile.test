# Dedicated verification image. Never use the player's production image/volume.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium fonts-noto-cjk libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund && npm cache clean --force

# Explicit allowlist: no saves, settings, credentials, host node_modules or Git.
COPY server ./server
COPY public ./public
COPY shared ./shared
COPY content ./content
COPY tests ./tests
COPY scripts ./scripts
COPY mcp ./mcp
COPY eslint.config.mjs tsconfig.json ./

ENV NODE_ENV=test \
    AI_DND_TEST_CONTAINER=1 \
    DATA_DIR=/tmp/ai-dnd-test-data \
    HOME=/tmp/ai-dnd-test-home \
    XDG_CONFIG_HOME=/tmp/ai-dnd-test-home/.config \
    XDG_CACHE_HOME=/tmp/ai-dnd-test-home/.cache \
    VERIFY_ARTIFACT_DIR=/test-artifacts \
    CHROMIUM_PATH=/usr/bin/chromium
USER node
ENTRYPOINT ["node", "scripts/container-verify.mjs"]
